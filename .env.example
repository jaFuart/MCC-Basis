# Local demonstration credentials. Set API_KEY before exposing the API remotely.
API_KEY=mcc-basis-local-demo-key
API_PORT=8000

POSTGRES_USER=mcc
POSTGRES_PASSWORD=mcc-local-password
POSTGRES_DB=mcc_basis

RABBITMQ_USER=mcc
RABBITMQ_PASSWORD=mcc-local-password
RABBITMQ_MANAGEMENT_PORT=15672

# Optional: set to a published image, e.g. ghcr.io/jafuart/mcc-basis:latest.
# APP_IMAGE=ghcr.io/jafuart/mcc-basis:latest
